# Copia este archivo a .env. Los valores de abajo sirven para desarrollo local.

ANTHROPIC_API_KEY=

# Base de datos de restaurantes, menus y pedidos (npm run db:up la levanta)
DATABASE_URL=postgres://pagodirecto:pagodirecto@localhost:5432/pagodirecto
# Dominio de los enlaces de los QR
PUBLIC_BASE_URL=http://localhost:3000
# Origenes del portal, separados por coma
CORS_ORIGINS=http://localhost:5173

# Los escribe `npm run agent:setup`
CLAUDE_AGENT_ID=
CLAUDE_ENVIRONMENT_ID=
# Tope por conversacion, en centavos de USD
CLAUDE_SESSION_BUDGET_CENTS=100

# App de Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v24.0

# Numeros autorizados, separados por coma. Vacio = nadie, * = todos
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_MAX_MESSAGES_PER_HOUR=30
WHATSAPP_HANDOFF_HOURS=12
# false = Claude responde sin mirar si un asesor atiende el chat en Odoo.
# En local no hay Odoo, asi que va apagado.
WHATSAPP_ODOO_GUARD=false
# Horas que Claude se abstiene tras el ultimo mensaje de un asesor en Odoo
WHATSAPP_HUMAN_HOURS=12
WHATSAPP_CONVERSATIONS_FILE=data/conversations.json

# Lectura del estado de cada chat en Odoo (solo si WHATSAPP_ODOO_GUARD=true)
ODOO_DB_HOST=/var/run/postgresql
ODOO_DB_NAME=odoo
ODOO_DB_USER=pagodirecto

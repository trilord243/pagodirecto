ANTHROPIC_API_KEY=

# Base de datos de restaurantes, menus y pedidos
DATABASE_URL=socket:/var/run/postgresql?db=pagodirecto&user=pagodirecto
# Dominio de los enlaces de los QR
PUBLIC_BASE_URL=https://pedidos.example.com
# Origenes del portal, separados por coma
CORS_ORIGINS=http://localhost:5173

# Los escribe `npm run agent:setup`
CLAUDE_AGENT_ID=
CLAUDE_ENVIRONMENT_ID=
# Tope por conversacion, en centavos de USD
CLAUDE_SESSION_BUDGET_CENTS=100

# App de Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v24.0

# Numeros autorizados, separados por coma. Vacio = nadie, * = todos
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_MAX_MESSAGES_PER_HOUR=30
WHATSAPP_HANDOFF_HOURS=12
# Horas que Claude se abstiene tras el ultimo mensaje de un asesor en Odoo
WHATSAPP_HUMAN_HOURS=12
WHATSAPP_CONVERSATIONS_FILE=data/conversations.json

# Lectura del estado de cada chat en Odoo
ODOO_DB_HOST=/var/run/postgresql
ODOO_DB_NAME=odoo
ODOO_DB_USER=pagodirecto

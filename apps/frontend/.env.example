# URL base del backend, sin barra final. Copia este archivo a .env para cambiarla.
# Sin definir o vacía, el portal llama a su mismo origen: así funciona en
# producción, donde https://pedidos.example.com sirve el portal y /restaurants.
VITE_API_URL=

# En desarrollo apunta al backend, que debe permitir http://localhost:5173:
# VITE_API_URL=http://localhost:3000
